{
  "name": "dsh-unreal-mcp",
  "version": "0.1.0",
  "description": "Unofficial DeepSeek Harness integration for Unreal Engine 5.8 Unreal MCP",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./project-context": {
      "types": "./dist/project-context.d.ts",
      "default": "./dist/project-context.js"
    }
  },
  "bin": {
    "dsh-unreal-mcp-diagnose": "dist/diagnose.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "skills",
    "licenses",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "unreal-engine",
    "ue5",
    "mcp"
  ],
  "homepage": "https://github.com/PeterTXPan/dsh-unreal-mcp#readme",
  "bugs": {
    "url": "https://github.com/PeterTXPan/dsh-unreal-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterTXPan/dsh-unreal-mcp.git"
  },
  "author": "PeterTXPan and contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/ensure-bin-mode.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "npm test && npm run verify:package",
    "diagnose": "node dist/diagnose.js",
    "prepare": "npm run build",
    "prepack": "npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
